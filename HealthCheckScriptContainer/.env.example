# Application
ENVIRONMENT=dev
LOG_LEVEL=INFO
SITE_ID=site-001

# Vault (required)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=REPLACE_WITH_SECURE_TOKEN
VAULT_KUBECONFIG_PATH=kv/kubeconfigs/du-cluster

# Kafka (required)
KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092
KAFKA_HEALTH_TOPIC=du.health.reports

# Loki (required)
LOKI_URL=https://loki.example.com
LOKI_TENANT_ID=
LOKI_LABELS={app="du-healthcheck",component="health"}

# Kubernetes selectors and namespace
NODE_LABEL_SELECTOR=ran.site=true
POD_LABEL_SELECTOR=du=true
K8S_NAMESPACE=default

# Connectivity
CU_HOST=cu.example.internal
CU_PORT=38472
RU_HOST=ru.example.internal
RU_PORT=22102
CONNECTIVITY_TIMEOUT=3.0

# Misc
REQUEST_TIMEOUT=8.0
AIRFLOW_ENABLED=false
