# Environment and Logging
ENVIRONMENT=dev
LOG_LEVEL=INFO
SITE_ID=site-001

# Vault settings
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=changeme
# For KV v2: <mount>/data/<path> or we auto-try to convert
VAULT_KUBECONFIG_PATH=kv/du-sites/site-001

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092
KAFKA_HEALTH_TOPIC=du.health.reports

# Loki settings
LOKI_URL=https://loki.example.com
LOKI_TENANT_ID=
LOKI_LABELS={app="du-healthcheck",env="dev"}

# Kubernetes selectors
NODE_LABEL_SELECTOR=ran.site=true,site_id=site-001
POD_LABEL_SELECTOR=du=true
K8S_NAMESPACE=du-namespace

# Connectivity checks
CU_HOST=cu.service.local
CU_PORT=38472
RU_HOST=ru.device.local
RU_PORT=22102
CONNECTIVITY_TIMEOUT=3.0

# Airflow
AIRFLOW_ENABLED=false

# Misc
REQUEST_TIMEOUT=8.0
